# ============================================================
# InvoiceIQ Environment Configuration Template
# ============================================================
# Copy this file to .env and fill in your Azure API credentials:
#   cp .env.example .env
# ============================================================

# Azure AI Document Intelligence
# Obtain from Azure Portal -> Document Intelligence -> Keys and Endpoint
DOCUMENT_INTELLIGENCE_ENDPOINT="https://<your-document-intelligence-resource>.cognitiveservices.azure.com/"
DOCUMENT_INTELLIGENCE_API_KEY="your_azure_document_intelligence_api_key_here"

# Azure AI Foundry / OpenAI Endpoint
# Endpoint pointing to your Azure AI Foundry / OpenAI deployment
FOUNDRY_ENDPOINT="https://<your-foundry-resource>.services.ai.azure.com/"
FOUNDRY_API_KEY="your_azure_foundry_api_key_here"
